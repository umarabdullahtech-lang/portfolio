    SOCKET["Socket.IO Progress"]
    API --> BULL
    BULL <--> REDIS
    BULL --> WORKERS
    CRON --> BULL
    WORKERS --> SOCKET --> SURFACES
  end

  subgraph INTELLIGENCE["Provider-Neutral Intelligence"]
    ROUTER["Model + Tool Router"]
    OPENAI["OpenAI / Azure OpenAI"]
    ANTHROPIC["Anthropic"]
    GEMINI["Google Gemini"]
    OSS["Compatible Open-Source Models"]
    TOOLS["Search / Browser / Image / Cost Tools"]
    WORKERS --> ROUTER
    ROUTER --> OPENAI
    ROUTER --> ANTHROPIC
    ROUTER --> GEMINI
    ROUTER --> OSS
    ROUTER <--> TOOLS
  end

  subgraph CONTENT["Content + Optimization Workflows"]
    STRATEGY["Audience + Topic Strategy"]
    GENERATE["Single / Bulk Content Generation"]
    IMAGE["Image Generation"]
    LINKING["Internal Linking + Metadata"]
    OPTIMIZE["LLM / AI Overview Optimization"]
    BRAND --> STRATEGY
    KEYWORDS --> STRATEGY
    ROUTER --> GENERATE
    STRATEGY --> GENERATE --> IMAGE
    GENERATE --> LINKING --> OPTIMIZE
