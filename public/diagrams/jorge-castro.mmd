flowchart LR
  USER["Brand / Agency / Operator"] --> SURFACES

  subgraph SURFACES["Product Surfaces"]
    WEB["Next.js SaaS Console"]
    TELESALES["Telesales Workspace"]
    ADMIN["Admin + Operations"]
    DESKTOP["Desktop Client"]
  end

  subgraph PLATFORM["Platform API"]
    API["Express Application API"]
    AUTH["Identity / Teams / Permissions"]
    BILLING["Credits / Plans / Stripe"]
    BRAND["Brand Context + Settings"]
    SURFACES --> API
    API --> AUTH
    API --> BILLING
    API --> BRAND
  end

  subgraph RESEARCH["Evidence Acquisition"]
    AUDIT["Site Audit + Crawl"]
    SERP["SERP + DataForSEO"]
    TRENDS["Trends + Competitors"]
    KEYWORDS["Keyword Universe"]
    VISIBILITY["AI Visibility + Citation Checks"]
    API --> AUDIT
    API --> SERP
    API --> TRENDS
    AUDIT --> KEYWORDS
    SERP --> KEYWORDS
    KEYWORDS --> VISIBILITY
  end

  subgraph QUEUE["Durable Orchestration"]
    BULL["Bull Job Queue"]
    REDIS[("Redis")]
