flowchart LR
  subgraph EXP["Experience Layer"]
    USER["User / Operator"]
    ENTRY["Extension / Plugin Interface"]
    USER -->|"Catalog / Customer Action"| ENTRY
  end

  subgraph APP["Application Layer"]
    CORE["Commerce & Fulfillment Workflow"]
    ENTRY -->|"Command / Event"| CORE
  end

  subgraph ID["Intelligence & Data Layer"]
    AI["AI / Model Processing"]
    DATA["Project Data Store"]
  end
  CORE -->|"Context / Task"| AI
  AI -->|"Enriched Result"| CORE
  CORE -->|"Read / Write"| DATA
  DATA -->|"State / Records"| CORE

  subgraph EXT["Integration Layer"]
    SERVICES["Commerce, Payment & Messaging APIs"]
  end
  CORE -->|"Validated Integration Call"| SERVICES
  SERVICES -->|"Response / Event"| CORE

  subgraph OUT["Outcome Layer"]
    RESULT["Order / Listing Outcome"]
  end
  CORE -->|"Processed Output"| RESULT --> USER

  OPS["Dockerized Runtime & Deployment"]
  OPS -.->|"Runs & Connects"| CORE
  OPS -.->|"Provisions"| DATA

